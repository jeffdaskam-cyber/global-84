rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // The single cohort this deployment serves, for rules that cannot see a
    // cohort ID in their path (the collection-group RSVP read). Keep in sync
    // with VITE_COHORT_ID, storage.rules, and CONFIGURED_COHORT_ID in
    // functions/src/memberAccessCore.ts.
    function configuredCohort() {
      return 'cohort84';
    }
    // Signed in with a *verified* email in the allowed domain. Necessary but
    // never sufficient on its own: the Firebase web API key is public, so
    // membership comes from the approved roster's access record below. NOTE:
    // the domain is hardcoded to match VITE_ALLOWED_EMAIL_DOMAIN (default
    // "du.edu"); update both if you fork.
    function hasVerifiedDuIdentity() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@du[.]edu$');
    }
    // cohorts/{cohortId}/access/{uid} is written only by Cloud Functions and
    // the operator script (Admin SDK). It is the authorization source.
    function accessPath(cohortId) {
      return /databases/$(database)/documents/cohorts/$(cohortId)/access/$(request.auth.uid);
    }
    function accessMatchesCaller(access) {
      return access.uid == request.auth.uid
        && access.email == request.auth.token.email.lower()
        && access.active == true;
    }
    function credentialAllowsTripData(access) {
      return access.credentialState == 'ready'
        // MIGRATION ONLY: time-limited access for existing members seeded by
        // the operator script. Remove this clause at final cutover.
        || (access.credentialState == 'legacy'
          && access.get('legacyUntil', null) is timestamp
          && request.time < access.legacyUntil);
    }
    // Approved, active roster membership in this cohort.
    function hasApprovedAccess(cohortId) {
      return hasVerifiedDuIdentity()
        && exists(accessPath(cohortId))
        && accessMatchesCaller(get(accessPath(cohortId)).data);
    }
    // Membership plus finished password setup. Pending, issuing, temporary,
    // and error states can sign in and change a password but read no trip data.
    function canUseTripData(cohortId) {
      return hasApprovedAccess(cohortId)
        && credentialAllowsTripData(get(accessPath(cohortId)).data);
    }
    function isSelf(cohortId, uid) {
      return canUseTripData(cohortId) && request.auth.uid == uid;
    }
    // A separate enabled allowlist entry on top of usable access; membership
    // never grants admin rights by itself.
    function isAdmin(cohortId) {
      return canUseTripData(cohortId)
        && exists(/databases/$(database)/documents/cohorts/$(cohortId)/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/cohorts/$(cohortId)/admins/$(request.auth.uid)).data.enabled == true;
    }
    // Program Leaders (professors): announcements + light moderation only.
    // Separate allowlist from admins so no existing isAdmin() check widens.
    function isProgramLeader(cohortId) {
      let p = /databases/$(database)/documents/cohorts/$(cohortId)/programLeaders/$(request.auth.uid);
      return canUseTripData(cohortId) && exists(p) && get(p).data.enabled == true;
    }
    function canAnnounce(cohortId) {
      return isAdmin(cohortId) || isProgramLeader(cohortId);
    }
    function canModerate(cohortId) {
      return isAdmin(cohortId) || isProgramLeader(cohortId);
    }
    function hasOnlyFields(data, required, optional) {
      return data.keys().hasAll(required)
        && data.keys().hasOnly(required.concat(optional));
    }
    function isTeamMember(cohortId, teamId) {
      return canUseTripData(cohortId)
        && exists(/databases/$(database)/documents/cohorts/$(cohortId)/teams/$(teamId)/members/$(request.auth.uid));
    }
    // Events come in two kinds. A missing `kind` means "scheduled" (docs
    // written before ad hoc events existed are not migrated). Scheduled events
    // require a time and a location. Ad hoc events may have startTime == null
    // and an empty locationName — but startTime must still be *present*, since
    // the Events list orders by it and Firestore drops docs missing that field.
    function isValidEvent(data) {
      let kind = data.get('kind', 'scheduled');
      return hasOnlyFields(
          data,
          ['title', 'city', 'startTime', 'locationName', 'description', 'status', 'createdAt', 'createdByUid', 'createdByName'],
          ['kind']
        )
        && kind in ['adhoc', 'scheduled']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.city in ['Singapore', 'Ho Chi Minh City', 'Denver']
        && data.locationName is string && data.locationName.size() <= 200
        && (
          (kind == 'scheduled'
            && data.startTime is timestamp
            && data.locationName.size() >= 1)
          || (kind == 'adhoc'
            && (data.startTime == null || data.startTime is timestamp))
        )
        && data.description is string && data.description.size() <= 5000
        && data.status in ['active', 'archived']
        && data.createdAt is timestamp
        && data.createdByUid is string && data.createdByUid.size() >= 1
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 80;
    }
    // Event discussion threads are private to attendees: a going/interested
    // RSVP on the event. RSVP doc ids are the member's uid.
    function isEventAttendee(cohortId, eventId) {
      let rsvpPath = /databases/$(database)/documents/cohorts/$(cohortId)/events/$(eventId)/rsvps/$(request.auth.uid);
      return exists(rsvpPath) && get(rsvpPath).data.status in ['going', 'interested'];
    }
    function isValidRsvp(data, uid) {
      return hasOnlyFields(data, ['uid', 'status', 'updatedAt', 'name'], [])
        && data.uid == uid
        && data.status in ['going', 'interested', 'not_going']
        && data.updatedAt is timestamp
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80;
    }
    function isValidPhotoCreate(data, cohortId) {
      return hasOnlyFields(
          data,
          ['url', 'storagePath', 'city', 'uploaderUid', 'uploaderName', 'createdAt'],
          ['displaySize', 'originalPath', 'originalUrl', 'originalSize', 'originalContentType']
        )
        && data.url is string && data.url.size() >= 1 && data.url.size() <= 4096
        && data.storagePath is string
        && data.city in ['singapore', 'vietnam']
        && data.uploaderUid == request.auth.uid
        && data.uploaderName is string && data.uploaderName.size() >= 1 && data.uploaderName.size() <= 80
        && data.createdAt is timestamp
        && (!data.keys().hasAny(['displaySize'])
          || (data.displaySize is int && data.displaySize >= 0))
        && data.storagePath.matches('photos/' + cohortId + '/' + request.auth.uid + '/.*')
        && isValidPhotoOriginal(data, cohortId);
    }
    // Optional full-resolution original fields. originalPath mirrors the
    // storagePath check so deletePhoto (Admin SDK) can never be pointed at
    // another member's object. It may also equal storagePath, for images the
    // client could not downscale (the display copy already is the original).
    function isValidPhotoOriginal(data, cohortId) {
      return (!data.keys().hasAny(['originalPath'])
          || (data.originalPath is string
            && (data.originalPath == data.storagePath
              || data.originalPath.matches('originals/' + cohortId + '/' + request.auth.uid + '/.*'))))
        && (!data.keys().hasAny(['originalUrl'])
          || (data.originalUrl is string && data.originalUrl.size() >= 1 && data.originalUrl.size() <= 4096))
        && (!data.keys().hasAny(['originalSize'])
          || (data.originalSize is int && data.originalSize >= 0))
        && (!data.keys().hasAny(['originalContentType'])
          || (data.originalContentType is string && data.originalContentType.size() <= 100));
    }
    // The uploader attaches the original to their own photo once its
    // background upload finishes. Nothing else on the doc may change.
    function onlyAddsOwnPhotoOriginal(cohortId) {
      return resource.data.uploaderUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['originalPath', 'originalUrl', 'originalSize', 'originalContentType'])
        && isValidPhotoOriginal(request.resource.data, cohortId);
    }
    function onlyChangesOwnPhotoLike() {
      let beforeLikes = resource.data.keys().hasAny(['likes']) ? resource.data.likes : [];
      let afterLikes = request.resource.data.likes;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && afterLikes is list
        && afterLikes.size() <= 100
        && afterLikes.toSet().size() == afterLikes.size()
        && afterLikes.removeAll([request.auth.uid]).toSet() == beforeLikes.removeAll([request.auth.uid]).toSet();
    }

    match /cohorts/{cohortId} {
      // Access records: a member may read their own, even before setup is
      // finished, so the app can show the right setup or denial screen.
      // Admins may read all of them. No client writes, ever.
      match /access/{uid} {
        allow get: if hasVerifiedDuIdentity() && request.auth.uid == uid;
        allow read: if isAdmin(cohortId);
        allow write: if false;
      }

      // Approved roster (email-keyed): admin-only, written by Cloud Functions.
      match /roster/{emailLower} {
        allow read: if isAdmin(cohortId);
        allow write: if false;
      }

      // Credential operation log: server-only. Never client-readable.
      match /credentialOperations/{operationId} {
        allow read, write: if false;
      }

      // Admin allowlist docs
      match /admins/{uid} {
        allow read: if isSelf(cohortId, uid) || isAdmin(cohortId);
        allow write: if false;
      }

      // Program Leader allowlist. Written only by the setMemberRole callable.
      match /programLeaders/{uid} {
        allow read: if isSelf(cohortId, uid) || isAdmin(cohortId);
        allow write: if false;
      }

      // Member profile docs
      match /members/{uid} {
        allow read: if isSelf(cohortId, uid) || isAdmin(cohortId);
        allow create: if isSelf(cohortId, uid)
          && hasOnlyFields(
            request.resource.data,
            ['uid', 'email', 'displayName', 'role', 'createdAt', 'lastLoginAt'],
            []
          )
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email is string && request.resource.data.email.size() <= 320
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.role == 'member'
          && request.resource.data.createdAt is timestamp
          && request.resource.data.lastLoginAt is timestamp;
        allow update: if isSelf(cohortId, uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'lastLoginAt'])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.lastLoginAt is timestamp;
        // Admin can update teamId field on any member (for team assignment)
        allow update: if isAdmin(cohortId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamId']);

        // Per-user saved Explore favorites
        match /favorites/{exploreId} {
          allow read, create, delete: if isSelf(cohortId, uid);
          allow update: if false;
        }

        // Per-user private file metadata (My Files feature) — March 10
        // Only the owning user can read, create, or delete — admins have no access.
        match /files/{fileId} {
          allow read, create, delete: if isSelf(cohortId, uid);
          allow update: if false;
        }

        // Per-user private flight itinerary segments (My Flight Info feature).
        // Owner-only: only the owning user can read, create, update, or delete —
        // admins have no access to another member's flights. Updates are allowed
        // (unlike files) because segment fields and segmentOrder are edited in
        // place. Bumped to force a fresh rules deploy.
        match /flights/{flightId} {
          allow read, create, update, delete: if isSelf(cohortId, uid);
        }

        // Per-device push notification (FCM) tokens.
        // Only the owning user can read, create, or delete — admins have no
        // access. Update is blocked; a changed token is a new doc (keyed by
        // the token) and stale docs are cleaned up server-side by the
        // notification Cloud Functions.
        match /fcmTokens/{token} {
          allow read, create, delete: if isSelf(cohortId, uid);
          allow update: if false;
        }
      }

      // Announcements: admins and Program Leaders manage; all members read.
      // authorRole is optional; when present it must match the caller's role
      // (drives the "Program Leader" badge). Authorship fields are immutable.
      match /announcements/{id} {
        allow read: if canUseTripData(cohortId);
        allow create: if canAnnounce(cohortId)
          && request.resource.data.createdByUid == request.auth.uid
          && (!('authorRole' in request.resource.data)
            || (request.resource.data.authorRole == 'programLeader'
              && isProgramLeader(cohortId)));
        allow update: if canAnnounce(cohortId)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['createdByUid', 'createdByName', 'authorRole', 'createdAt']);
        allow delete: if canAnnounce(cohortId);
      }

      // Cohort itinerary (admin-managed; all members read). The trip leader's
      // dated plan; feeds the Home "Up Next" module.
      match /itinerary/{id} {
        allow read: if canUseTripData(cohortId);
        allow create, update, delete: if isAdmin(cohortId);
      }

      // Explore items (admins manage; all members can read)
      // The `favoriteCount` field is written only by the onFavoriteChange Cloud
      // Function via the Admin SDK, which bypasses these rules. Do not open a
      // client write path for it — members must not be able to inflate it.
      match /explore/{id} {
        allow read: if canUseTripData(cohortId);
        allow create: if isAdmin(cohortId);
        allow update, delete: if isAdmin(cohortId);
      }

      // Events (members can read/create; creator or admins can mutate)
      match /events/{eventId} {
        allow read: if canUseTripData(cohortId);
        allow create: if canUseTripData(cohortId)
          && request.resource.data.createdByUid == request.auth.uid
          && isValidEvent(request.resource.data);
        allow update: if (isAdmin(cohortId)
            || (canUseTripData(cohortId) && resource.data.createdByUid == request.auth.uid))
          && isValidEvent(request.resource.data)
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.createdByName == resource.data.createdByName
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isAdmin(cohortId)
          || (canUseTripData(cohortId) && resource.data.createdByUid == request.auth.uid);

        match /rsvps/{uid} {
          allow read: if canUseTripData(cohortId);
          allow create, update: if isSelf(cohortId, uid)
            && isValidRsvp(request.resource.data, uid);
          allow delete: if isSelf(cohortId, uid) || isAdmin(cohortId);
        }

        // Event discussion thread: private to attendees.
        // Read + post require a going/interested RSVP on this event; admins can
        // read and delete for moderation. Program Leaders may delete only in
        // threads they have joined, and get no extra read. Update never allowed.
        match /messages/{messageId} {
          allow read: if isAdmin(cohortId)
            || (canUseTripData(cohortId) && isEventAttendee(cohortId, eventId));
          allow create: if canUseTripData(cohortId)
            && isEventAttendee(cohortId, eventId)
            && request.resource.data.createdByUid == request.auth.uid
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 1000;
          allow delete: if isAdmin(cohortId)
            || (isProgramLeader(cohortId) && isEventAttendee(cohortId, eventId));
          allow update: if false;
        }
      }

      // Group chat
      match /messages/{messageId} {
        allow read: if canUseTripData(cohortId);
        allow create: if canUseTripData(cohortId)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000;
        allow delete: if canModerate(cohortId);
        allow update: if false;
      }

      // Photos (any signed-in user can read; uploader can create; admins and
      // Program Leaders can delete)
      // Photo metadata is immutable after creation. Members may only add or
      // remove their own reaction, so a privileged admin delete can never be
      // redirected to another user's Storage object.
      match /photos/{photoId} {
        allow read: if canUseTripData(cohortId);
        allow create: if canUseTripData(cohortId)
          && isValidPhotoCreate(request.resource.data, cohortId);
        allow update: if canUseTripData(cohortId)
          && (onlyChangesOwnPhotoLike() || onlyAddsOwnPhotoOriginal(cohortId));
        allow delete: if canModerate(cohortId);
      }

      // Import logs (admin only)
      match /importLogs/{logId} {
        allow read, write: if isAdmin(cohortId);
      }

      // Media — videos and articles (admin-managed)
      match /media/{mediaId} {
        allow read: if canUseTripData(cohortId);
        allow create, update, delete: if isAdmin(cohortId);
      }

      // Links — shared trip-planning links (any member creates; creator or admin deletes)
      match /links/{linkId} {
        allow read: if canUseTripData(cohortId);
        allow create: if canUseTripData(cohortId)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.url is string
          && request.resource.data.url.size() <= 500
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 200;
        allow update, delete: if isAdmin(cohortId)
          || (canUseTripData(cohortId) && resource.data.createdByUid == request.auth.uid);
      }

      // Trip documents — shared PDFs from program leadership. Any member may
      // upload; the uploader or an admin may delete. Immutable once uploaded:
      // replacing a document means deleting it and uploading the new version,
      // which keeps the Storage object and the metadata doc from drifting apart.
      match /tripDocs/{docId} {
        allow read: if canUseTripData(cohortId);
        allow create: if canUseTripData(cohortId)
          && request.resource.data.uploadedBy == request.auth.uid
          && request.resource.data.fileName is string
          && request.resource.data.fileName.size() <= 300
          && request.resource.data.storagePath is string
          && request.resource.data.fileSize is number
          && request.resource.data.fileSize <= 10 * 1024 * 1024
          && request.resource.data.city in ['singapore', 'vietnam', 'all'];
        allow delete: if isAdmin(cohortId)
          || (canUseTripData(cohortId) && resource.data.uploadedBy == request.auth.uid);
        allow update: if false;
      }

      // Teams — private small-group hubs. Assigned members can read the team
      // record and roster needed by their view; only admins manage them.
      match /teams/{teamId} {
        allow get: if isAdmin(cohortId) || isTeamMember(cohortId, teamId);
        allow list, create, update, delete: if isAdmin(cohortId);

        match /members/{uid} {
          allow read: if isAdmin(cohortId) || isTeamMember(cohortId, teamId);
          allow write: if isAdmin(cohortId);
        }

        match /messages/{messageId} {
          allow read: if isTeamMember(cohortId, teamId);
          allow create: if isTeamMember(cohortId, teamId)
            && request.resource.data.createdByUid == request.auth.uid
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 1000;
          allow delete: if isAdmin(cohortId);
          allow update: if false;
        }

        match /meetings/{meetingId} {
          allow read: if isAdmin(cohortId)
            || isTeamMember(cohortId, teamId);
          allow create, update, delete: if isAdmin(cohortId);
        }
      }
    }

    // Collection-group read for RSVPs so a member can query their own RSVPs
    // across every event (Home "Up Next"). Writes stay governed by the nested
    // events/{eventId}/rsvps/{uid} rule above. Collection-group rules cannot
    // see the cohort in the path, so this grants only the caller's own RSVP
    // docs (provable from the query's uid filter) and only while they hold
    // usable access in the configured cohort.
    match /{path=**}/rsvps/{rsvpId} {
      allow read: if canUseTripData(configuredCohort())
        && resource.data.uid == request.auth.uid;
    }
  }
}
